// ==========================================
// RÈGLES FIREBASE STORAGE — Screen To Street
// ==========================================
// NOUVEAU FICHIER (demande du 02/11/2026, "point 2" du plan de perf discuté pour
// Community — sortir les photos du compte de Firestore vers Firebase Storage). Comme
// firestore.rules juste à côté : ce fichier n'est PAS déployé automatiquement (site
// 100% statique, sans Firebase CLI/CI configuré) — il sert de référence à copier-coller
// manuellement dans la console Firebase (Storage > Rules > coller tout ce fichier >
// Publier). Storage n'a encore jamais été utilisé sur ce projet : il faut aussi
// l'ACTIVER depuis la console (Storage > Commencer) avant que ces règles ne
// s'appliquent à quoi que ce soit.
//
// Chaque chemin ci-dessous correspond exactement à un appel uploadPhotoToStorage()/
// deletePhotoFromStorage() dans firebase-init.js (ou script.js/account.html pour les
// deux derniers) — gardez les deux synchronisés, comme pour firestore.rules.
// Lecture publique partout (ces photos sont déjà montrées publiquement par le site :
// profil public, fil Community, avis sur la fiche d'un lieu...) — seul le propriétaire
// (uid == auth.uid) peut écrire/supprimer SES PROPRES fichiers, sous SON PROPRE dossier
// users/{uid}/.
//
// IMPORTANT — CORS : la fonctionnalité "partager en story/copier l'image" (voir
// makeFile()/toDataUriIfPossible() dans script.js) capture une carte en image via
// html-to-image, qui a besoin que les <img> qu'elle lit soient servies avec des en-têtes
// CORS permissifs pour ne pas "tainter" le canvas — sinon l'image est silencieusement
// absente de la carte générée (dégradation progressive déjà prévue dans ce flux, pas un
// crash). Une fois Storage activé, exécuter UNE FOIS (gsutil, ou Cloud Shell) :
//   gsutil cors set storage-cors.json gs://screen-to-street-e29ff.firebasestorage.app
// avec un storage-cors.json autorisant l'origine du site en GET.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photos de publications autonomes (addProfilePhoto/updateProfilePhoto/
    // deleteProfilePhoto/adminDeleteProfilePhoto, firebase-init.js).
    match /users/{uid}/photos/{photoId} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photo attachée à un avis (setLocationReview/deleteLocationReview, firebase-init.js)
    // — un seul fichier par lieu noté (chemin déterministe, voir son commentaire).
    match /users/{uid}/reviews/{locationId} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photo de profil (avatar) — account.html.
    match /users/{uid}/avatar.jpg {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Couverture d'un voyage — applyChangeCover() dans script.js.
    match /users/{uid}/trips/{tripId}/cover.jpg {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photo attachée à une visite enregistrée — qaSaveVisit() dans script.js.
    match /users/{uid}/visits/{locationId}/{visitId} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
